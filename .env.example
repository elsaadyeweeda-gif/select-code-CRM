# ==============================================================================
# DATABASE CONFIGURATION (Supports Vercel & GitHub Deployments)
# ==============================================================================
# You can choose either OPTION A (PostgreSQL / Neon) or OPTION B (Firebase Firestore).
# The application automatically detects and uses PostgreSQL if DATABASE_URL or POSTGRES_URL is set;
# otherwise, it seamlessly falls back to Firebase Firestore.

# ------------------------------------------------------------------------------
# OPTION A: PostgreSQL / Neon (Recommended for Vercel)
# ------------------------------------------------------------------------------
# Automatically set by Vercel when connecting a Neon or Vercel Postgres database:
# DATABASE_URL="postgres://username:password@ep-sample-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require"
# POSTGRES_URL="postgres://username:password@ep-sample-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require"
# POSTGRES_URL_NON_POOLING="postgres://username:password@ep-sample-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# OPTION B: Firebase Firestore (Cloud Database)
# ------------------------------------------------------------------------------
# Required only if not using PostgreSQL. Set these in Vercel Environment Variables:
# FIREBASE_PROJECT_ID="gen-lang-client-0202450278"
# FIREBASE_API_KEY="AIzaSyAhBm3zi7duAqEP2YE8LAq875Gqax4oe-4"
# FIREBASE_APP_ID="1:897941865057:web:d187b1a410368533b56020"
# FIREBASE_AUTH_DOMAIN="gen-lang-client-0202450278.firebaseapp.com"
# FIREBASE_DATABASE_ID="ai-studio-cf26c8fc-80c4-49c9-9b47-5ee3badc526a"
# FIREBASE_STORAGE_BUCKET="gen-lang-client-0202450278.firebasestorage.app"
# FIREBASE_MESSAGING_SENDER_ID="897941865057"
# (Or optionally full JSON: FIREBASE_CONFIG='{"projectId":"...","apiKey":"..."}')

# ------------------------------------------------------------------------------
# SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
JWT_SECRET="your_custom_jwt_secret_key_change_me_in_production"

# ------------------------------------------------------------------------------
# AI & INTEGRATION
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
